<?xml version="1.0" encoding="utf-8"?>
<XnaContent xmlns:Graphics="Microsoft.Xna.Framework.Content.Pipeline.Graphics">
  <Asset Type="Graphics:FontDescription">
    <FontName>Segoe UI</FontName>
    <Size>20</Size>
    <Spacing>0</Spacing>
    <UseKerning>true</UseKerning>
    <Style>Bold</Style>
    <CharacterRegions>
      <CharacterRegion>
        <Start>&#32;</Start>
        <End>&#126;</End>
      </CharacterRegion>
      <!-- Latin Extended-A (š, ć, č, ž, đ, ...) -->
      <CharacterRegion>
        <Start>&#256;</Start>
        <End>&#383;</End>
      </CharacterRegion>
    </CharacterRegions>
  </Asset>
</XnaContent>
